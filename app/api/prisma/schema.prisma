// Models are added by each feature plan (F1 adds User and Session).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// F1.R2, F1.R4: emailKey is the normalized (trimmed, lower-cased) email and is
// unique in the database. email holds the same normalized value.
model User {
  id           String    @id @default(uuid())
  email        String
  emailKey     String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  sessions     Session[]
  trips        Trip[]
}

// F1.R7: id is the SHA-256 hash of the session token. The token itself is never stored.
model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// F2.R2, F2.R9: ownerId is set by the server from the session. Trips are read by owner
// and ordered by creation time (F2.R10), so the index is on (ownerId, createdAt).
// name is not unique: duplicate names are allowed for one owner (F2.AC3).
model Trip {
  id        String   @id @default(uuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  @@index([ownerId, createdAt])
}
